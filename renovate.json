{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Strip the leading 'v' from busted GitHub release tags",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "lunarmodules/busted"
      ],
      "extractVersion": "^v(?<version>.*)$"
    }
  ]
}
